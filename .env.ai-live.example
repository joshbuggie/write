# Copy to .env.ai-live for the optional live AI suite (`npm run test:ai-live`; see CONTRIBUTING.md).
# It calls real APIs and spends real credits, a few cents per full run. Never used in CI.
# Paste each key after the `=`, no quotes. A provider left blank is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the cheap default models the suite uses.
# AI_LIVE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# AI_LIVE_OPENAI_MODEL=gpt-5.4-nano
# AI_LIVE_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
