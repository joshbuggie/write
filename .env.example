# Copy to .env.local for bare-metal runs (`npm start` / `npm run dev` read it).
# With Docker Compose, put WRITE_PASSWORD in a .env file next to docker-compose.yml instead.

# Where your notes live, as plain .md files. Relative paths resolve from the directory you start
# the server in. Default: ./data (bare metal), /data (Docker image).
# WRITE_DATA_DIR=./data

# Turns on the sign-in page. Also accepted as `Authorization: Bearer <password>` for scripts.
# Leave unset only on localhost or a network you trust. Changing it signs out every device.
# WRITE_PASSWORD=

# Standard Next.js server settings.
# PORT=3000
# HOSTNAME=0.0.0.0
