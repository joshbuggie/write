# Copy to .env.local for bare-metal runs: `npm start` and `npm run dev` load WRITE_DATA_DIR,
# WRITE_CONFIG_DIR and WRITE_PASSWORD from it. With Docker Compose, put WRITE_PASSWORD in a .env file
# next to docker-compose.yml instead.

# Where your notes live, as plain .md files. Relative paths resolve from the directory you start
# the server in. Default: ./data (bare metal), /data (Docker).
# WRITE_DATA_DIR=./data

# Where write keeps its own settings, in settings.json: today the AI assistant's connections and
# their API keys, in plain text. Keep it outside WRITE_DATA_DIR, so a synced notes folder never carries
# your keys: write refuses a folder it can see is inside WRITE_DATA_DIR (symlinks followed), but in
# Docker two mounts of the same host folder look separate, so keep those apart yourself.
# Relative paths resolve like WRITE_DATA_DIR. Default: ./config (bare metal), /config (Docker).
# WRITE_CONFIG_DIR=./config

# Turns on the sign-in page. Also accepted as `Authorization: Bearer <password>` for scripts.
# Leave unset only on localhost or a network you trust. Changing it signs out every device.
# Set it before you turn on the AI assistant anywhere others can reach write.
# WRITE_PASSWORD=

# The port and bind address CAN'T be set in this file: `npm start` picks them before it reads .env
# files, so PORT or HOSTNAME here are silently ignored. Pass flags instead:
#   npm start -- -p 8080 -H 127.0.0.1
# PORT=8080 also works as a real environment variable (shell, systemd). `npm start` ignores
# HOSTNAME even there; it only applies to the Docker image.
